
//package ;

import javax.microedition.lcdui.*;
import javax.microedition.rms.*;

class SettingsC extends ListC{
    
    Command BACK = new Command("Back", Command.BACK, 4);
    
    InputSwitch colorSwitch;
    InputField ipField;
    
    public static final int COLOR_ID = 0;
    public static final int IP_ID = 1;
    
    SettingsC(Demma app) {
        super(app);
        
        this.addCommand(BACK);
        
        off_y_f = 40;
        
        title = "settings";
        
        setList(new String[]{
            "colors:"
            , ""
            , "host ip"
            , ""
            , ""
            , ""
            , ""
            , ""
            });
            
        colorSwitch = new InputSwitch(app, getWidth()/2, off_y_f + (charHeight() * 1), "boring", "cool");
        
        byte[] b = getRecord(COLOR_ID);
        
        if(b != null){
            colorSwitch.active = b[0] == 0x01;
        }
        
        ipField = new InputField(getWidth() - 60);
        ipField.x = 30;
        ipField.y = off_y_f + (charHeight() * 3) + 1;
        
        b = getRecord(IP_ID);
        if(b != null){
            try{
                ipField.setString(new String(b));
            }catch (Exception e){}
        }
        
    }
    
    protected void paint(Graphics g){
        g.setColor(app.color_settings_bg);
        g.fillRect(0, 0, getWidth(), getHeight());
        
        int y = off_y_f + off_y;
        g.setColor(app.color_font);
        for(int i = 0; i < list.length; i++){
            if(i == select){
                g.setColor(app.color_selected);
                g.fillRect(5, y - 2, getWidth() - 10, charHeight());
                g.setColor(app.color_font);
            }
            
            g.drawString(list[i], getWidth()/2, y, (Graphics.TOP | Graphics.HCENTER));
            y += charHeight();
        }
        
        colorSwitch.paint(g, font);
        
        ipField.paint(g, font.getHeight());
        
        paintTitle(g);
    }
    
    protected void keyPressed(int keycode){
        int left = getKeyCode(LEFT);
        int right = getKeyCode(RIGHT);
        
        if(select == 1){
            if(keycode == -8){
                colorSwitch.press();
            }
        }
        else if(select == 3){
            if(' ' <= keycode && keycode <= '~'){
                ipField.keyPressed(keycode);
            }
            else if(keycode == 8){
                if(ipField.toString().length() > 0)
                    ipField.delete();
            }
            else if(keycode == left){
                ipField.cursorLeft();
            }
            else if(keycode == right){
                ipField.cursorRight();
            }
        }
        
        super.keyPressed(keycode);
    }
    
    public void commandAction(Command command, Displayable d){
        if(command == BACK){
            save();
            app.returnFromSettings();
        }
        
        super.commandAction(command, d);
    }
    
    private void save(){
        if(colorSwitch.active)
            setRecord(COLOR_ID, new byte[]{0x01});
        else
            setRecord(COLOR_ID, new byte[]{0x00});
           
        setRecord(IP_ID, ipField.toString().getBytes());
        
    }
    
    public static byte[] getRecord(int id){
        return getRecord(id, "settings");
    }
    
    public static byte[] getRecord(int id, String recordFile){
        
        byte[] resp = new bytes[]{};
        
        try{
            RecordStore rs = RecordStore.openRecordStore(recordFile, true);
            RecordEnumeration re = rs.enumerateRecords(null, null, false);
            
            int i = 0;
            while(re.hasNextElement()){
                byte[] b = re.nextRecord();
                if(i == id){
                    resp = b;
                }
                i++;
            }
            
            rs.closeRecordStore();
        } catch (Exception e){};
        
        return resp;
    }
    
    public static void setRecord(int id, byte[] bytes){
        setRecord(id, bytes, "settings");
    }
    
    public static void setRecord(int id, byte[] bytes, String recordFile){
        try{
            RecordStore rs = RecordStore.openRecordStore(recordFile, true);
            RecordEnumeration re = rs.enumerateRecords(null, null, false);
            
            int i = 0;
            int id_temp;
            while(re.hasNextElement()){
                id_temp = re.nextRecordId();
                if(i == id){
                    rs.setRecord(id_temp, bytes, 0, bytes.length);
                }
                i++;
            }
            for(; i <= id; i++){
                if(i == id)
                    rs.addRecord(bytes, 0, bytes.length);
                else
                    rs.addRecord(new byte[]{0x00}, 0, 1);
            }
            
            rs.closeRecordStore();
        } catch (Exception e){};
    }
} 
